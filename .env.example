# ──────────────────────────────────────────────────────────────────────────────
# Mummy2Be environment variables
# Copy this file to `.env` and fill in each value. SETUP.md explains where every
# value comes from, step by step.
# ──────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string.
# Get this from Neon (https://neon.tech, free tier) - see SETUP.md step 4.
# It looks like: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full
# Use sslmode=verify-full, not sslmode=require. They behave identically today,
# but a future pg release makes `require` skip certificate verification.
DATABASE_URL=

# A long random string that secures Payload admin sessions.
# Generate one by running this in a terminal:  node -e "console.log(crypto.randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# The public URL of the site.
# Local development: http://localhost:3000
# Production:        https://mummy2be.com (or your Vercel URL until the domain is connected)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Resend API key for transactional email (owner notification + customer auto-reply).
# Create a free account at https://resend.com → API Keys → Create API Key.
# Leave empty during local development if you like - inquiries are still saved in
# the admin; emails are simply skipped (and logged to the terminal).
RESEND_API_KEY=

# The "from" address for emails sent by the site.
# Before you verify a domain in Resend, you MUST use: Mummy2Be <onboarding@resend.dev>
# (Resend's test sender - it can only deliver to the email address of your own
# Resend account.) After verifying a domain in Resend, change it to e.g.:
# Mummy2Be <hello@mummy2be.com>
RESEND_FROM=Mummy2Be <onboarding@resend.dev>

# Where new-inquiry notifications are sent (the business inbox).
OWNER_NOTIFICATION_EMAIL=RentWithMummy2Be@gmail.com

# Google Analytics 4 measurement ID (looks like G-XXXXXXXXXX).
# Create a GA4 property at https://analytics.google.com → Admin → Data streams.
# Leave empty to disable analytics (e.g. during development).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional: full URL of the business Instagram profile (a follow LINK only - the
# site never embeds an Instagram feed). Defaults to https://www.instagram.com/_mummy2be_
NEXT_PUBLIC_INSTAGRAM_URL=

# Production only (set automatically by Vercel when you create a Blob store):
# BLOB_READ_WRITE_TOKEN=
